{
  "name": "provisionly",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:colors": "node scripts/check-colors.mjs",
    "setup:hooks": "node scripts/setup-pre-commit.mjs",
