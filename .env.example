# Copy to .env.local (never commit .env.local)

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Public key (browser-safe). Either works:
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-legacy-anon-jwt

# Server-only — NEVER prefix with NEXT_PUBLIC_ and NEVER commit
# Required for list/database writes on newer Supabase projects (ES256 JWT + RLS workaround)
# Supabase → Project Settings → API → service_role (secret) or legacy service_role JWT
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional — used for share links in production (defaults to VERCEL_URL or localhost)
# NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
